{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prodiges portable skill report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_name",
    "startup_id",
    "generated_at",
    "language",
    "summary",
    "recommendations",
    "evidence",
    "assumptions",
    "open_questions",
    "next_tasks",
    "mentor_review",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_name": {
      "enum": [
        "prodiges-customer-discovery",
        "prodiges-competition-positioning",
        "prodiges-offer-pricing",
        "prodiges-startup-review"
      ]
    },
    "startup_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "rationale",
          "evidence_ids",
          "status"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "proposed",
              "supported",
              "needs_validation"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "claim",
          "locator",
          "source_date",
          "observed_at",
          "assessment",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "assumption",
              "secondary_research",
              "customer_interview",
              "observed_use",
              "commercial_commitment",
              "subsequent_outcome"
            ]
          },
          "claim": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessment": {
            "enum": [
              "supports",
              "contradicts",
              "mixed",
              "unknown"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owner",
          "due_date",
          "depends_on",
          "deliverable",
          "acceptance_criteria",
          "evidence_required",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "submitted",
              "changes_requested",
              "accepted"
            ]
          }
        }
      }
    },
    "mentor_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "questions",
        "decision",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "proposed",
            "needs_review",
            "human_accepted",
            "changes_requested"
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "human_accepted"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "format",
          "location"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  }
}

